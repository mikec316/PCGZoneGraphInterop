# Visual Studio 2015 user specific files
PCG_ZoneGraph_Interop/.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
PCG_ZoneGraph_Interop/SourceArt/**/*.png
PCG_ZoneGraph_Interop/SourceArt/**/*.tga

# Binary Files
PCG_ZoneGraph_Interop/Binaries/*
Plugins/**/Binaries/*

# Builds
PCG_ZoneGraph_Interop/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!PCG_ZoneGraph_Interop/Build/*/
PCG_ZoneGraph_Interop/Build/*/**
!PCG_ZoneGraph_Interop/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!PCG_ZoneGraph_Interop/Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
PCG_ZoneGraph_Interop/Saved/*

# Compiled source files for the engine to use
PCG_ZoneGraph_Interop/Intermediate/*

# Cache files for the editor to use
PCG_ZoneGraph_Interop/DerivedDataCache/*